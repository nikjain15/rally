{"text": "thanks @alice and @bob for reviewing the RFC", "expected": [{"helperHandle": "alice", "kind": "reviewed"}, {"helperHandle": "bob", "kind": "reviewed"}]}
{"text": "@carol and @dana both unblocked me today, thank you both", "expected": [{"helperHandle": "carol", "kind": "unblocked"}, {"helperHandle": "dana", "kind": "unblocked"}]}
